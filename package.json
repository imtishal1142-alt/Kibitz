{
  "name": "chess-coach",
  "version": "0.3.1",
  "description": "Local-first chess analysis and coaching app: web, offline and desktop (Stockfish WASM, Chess.com public data)",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "chess",
    "stockfish",
    "wasm",
    "analysis",
    "coaching",
    "chess.com"
  ],
  "scripts": {
    "test": "npm run prepare-assets && vitest run",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && npm run typecheck && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests electron",
    "test:e2e": "node tests/e2e/run.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.10.2",
    "chess.js": "^1.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "idb": "^8.0.4",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "stockfish": "^19.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "main": "electron/main.cjs",
  "author": "Kibitz",
  "homepage": "./",
  "build": {
    "appId": "app.kibitz.chess",
    "productName": "Kibitz",
    "copyright": "GPL-3.0-or-later",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Kibitz <noreply@example.invalid>",
      "synopsis": "Chess analysis and coaching",
      "syncDesktopName": true,
      "executableName": "kibitz"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.board-games"
    },
    "publish": null
  },
  "desktopName": "kibitz.desktop",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/kibitz.git"
  }
}
